{
  "skill_id": "clipen-core",
  "version": "3.0.0",
  "name": "Clipen 製作核心",
  "description": "所有影片製作 Skill 共用的取證、剪輯、字幕、聲音、畫面元件與交付流程，以及內建的畫面設計素材。",
  "renderer": "clipen.program-components.v1",
  "required_capabilities": [
    "source_frames",
    "source_editing",
    "program_components",
    "audio_layers",
    "preview"
  ],
  "limitations": [
    "畫面指示使用固定目標位置，沒有自動物件追蹤。",
    "音訊量測不代表 AI 已聆聽；ASR 與對齊結果各自標示驗證狀態。"
  ],
  "provenance": "Clipen original instructions, presets and procedural graphics. No third-party footage or music bundled. Original OFL-1.1 Chenyuluoyan and Iansui fonts are bundled with their licenses and pinned source hashes.",
