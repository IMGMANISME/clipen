#!/usr/bin/env python3
"""First-run installer for a Clipen source checkout."""

from pathlib import Path
import sys


if sys.version_info < (3, 10):
    print("Clipen 需要 Python 3.10 或更新版本。", file=sys.stderr)
    raise SystemExit(2)

repo_root = Path(__file__).resolve().parent
sys.path.insert(0, str(repo_root / "src"))

from clipen.bootstrap import main  # noqa: E402


if sys.argv[1:] in (["--help"], ["-h"]):
    print("用法：./install")
    raise SystemExit(0)
if sys.argv[1:]:
    print("用法：./install", file=sys.stderr)
    raise SystemExit(2)

raise SystemExit(main(repo_root, ["install"]))
