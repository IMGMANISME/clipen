{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://clipen.local/schemas/v2/plan-proposal.schema.json",
  "title": "Clipen structured edit blueprint proposal",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "title", "summary", "creative_direction", "sections"],
  "properties": {
    "schema_version": { "const": 2 },
    "title": { "$ref": "#/$defs/title" },
    "summary": { "$ref": "#/$defs/summary" },
    "creative_direction": { "$ref": "#/$defs/creativeDirection" },
    "sections": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": { "$ref": "#/$defs/section" }
    }
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160,
      "pattern": "[^\\s\\u0000]"
    },
    "summary": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2000,
      "pattern": "[^\\s\\u0000]"
    },
    "creativeDirection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "target_duration_seconds",
        "pacing",
        "subtitle_mode",
        "graphics_intensity",
        "music",
        "sound_design"
      ],
      "properties": {
        "target_duration_seconds": {
          "type": ["integer", "null"],
          "minimum": 1,
          "maximum": 21600
        },
        "pacing": { "enum": ["relaxed", "balanced", "energetic"] },
        "subtitle_mode": { "enum": ["none", "dialogue", "full", "dynamic"] },
        "graphics_intensity": { "enum": ["minimal", "balanced", "expressive"] },
        "music": {
          "type": "object",
          "additionalProperties": false,
          "required": ["mode", "mood"],
          "properties": {
            "mode": { "enum": ["none", "ambient_only", "approved_asset_required"] },
            "mood": {
              "type": "string",
              "maxLength": 160,
              "pattern": "^[^\\u0000]*$"
            }
          }
        },
        "sound_design": {
          "type": "string",
          "maxLength": 1000,
          "pattern": "^[^\\u0000]*$"
        }
      }
    },
    "effect": {
      "type": "object",
      "additionalProperties": false,
      "required": ["effect", "intensity"],
      "properties": {
        "effect": { "enum": ["punch_in", "slow_push", "reframe", "speed_ramp"] },
        "intensity": { "enum": ["subtle", "medium", "strong"] }
      }
    },
    "clip": {
      "type": "object",
      "additionalProperties": false,
      "required": ["candidate_id", "role", "audio_treatment", "effects"],
      "properties": {
        "candidate_id": { "$ref": "#/$defs/identifier" },
        "role": { "enum": ["hook", "story", "b_roll", "reaction", "transition", "ending"] },
        "audio_treatment": { "enum": ["dialogue", "ambient", "mixed", "mute"] },
        "effects": {
          "type": "array",
          "maxItems": 8,
          "items": { "$ref": "#/$defs/effect" }
        }
      }
    },
    "titleCue": {
      "type": "object",
      "additionalProperties": false,
      "required": ["cue_id", "text", "placement", "style"],
      "properties": {
        "cue_id": { "$ref": "#/$defs/identifier" },
        "text": {
          "type": "string",
          "minLength": 1,
          "maxLength": 240,
          "pattern": "[^\\s\\u0000]"
        },
        "placement": { "enum": ["section_start", "over_clip", "section_end"] },
        "style": { "enum": ["minimal", "chapter", "location", "ending"] }
      }
    },
    "soundCue": {
      "type": "object",
      "additionalProperties": false,
      "required": ["cue_id", "sound", "placement", "intensity"],
      "properties": {
        "cue_id": { "$ref": "#/$defs/identifier" },
        "sound": { "enum": ["whoosh", "impact", "click", "riser", "ambient_accent"] },
        "placement": { "enum": ["section_start", "section_middle", "section_end"] },
        "intensity": { "enum": ["subtle", "medium", "strong"] }
      }
    },
    "section": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "section_id",
        "title",
        "purpose",
        "clips",
        "title_cues",
        "sound_cues",
        "transition_out",
        "edit_notes",
        "unknowns"
      ],
      "properties": {
        "section_id": { "$ref": "#/$defs/identifier" },
        "title": { "$ref": "#/$defs/title" },
        "purpose": { "$ref": "#/$defs/summary" },
        "clips": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "items": { "$ref": "#/$defs/clip" }
        },
        "title_cues": {
          "type": "array",
          "maxItems": 8,
          "items": { "$ref": "#/$defs/titleCue" }
        },
        "sound_cues": {
          "type": "array",
          "maxItems": 16,
          "items": { "$ref": "#/$defs/soundCue" }
        },
        "transition_out": { "enum": ["cut", "dissolve", "fade", "whip"] },
        "edit_notes": {
          "type": "string",
          "maxLength": 4000,
          "pattern": "^[^\\u0000]*$"
        },
        "unknowns": {
          "type": "array",
          "maxItems": 128,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500,
            "pattern": "[^\\s\\u0000]"
          }
        }
      }
    }
  }
}
