{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://clipen.local/schemas/v1/authorized-operation-command.schema.json",
  "title": "Authorized operation command",
  "type": "object",
  "additionalProperties": false,
  "required": ["request_id", "expected_revision", "consent"],
  "properties": {
    "request_id": { "type": "string", "format": "uuid" },
    "expected_revision": { "type": "integer", "minimum": 0 },
    "consent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["action", "provider", "data_scope_id"],
      "properties": {
        "action": { "type": "string", "minLength": 1, "maxLength": 64 },
        "provider": { "type": "string", "enum": ["codex", "claude", "gemini", "local"] },
        "data_scope_id": { "type": "string", "minLength": 1, "maxLength": 128 }
      }
    }
  }
}
