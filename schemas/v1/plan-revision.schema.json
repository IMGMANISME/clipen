{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://clipen.local/schemas/v1/plan-revision.schema.json",
  "title": "Clipen Plan Revision",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "plan_id",
    "project_id",
    "revision",
    "status",
    "content_hash",
    "material_snapshot_id",
    "analysis_snapshot_id",
    "system_skill_release",
    "title",
    "summary",
    "sections"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "plan_id": {
      "$ref": "#/$defs/identifier"
    },
    "project_id": {
      "$ref": "#/$defs/identifier"
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "status": {
      "enum": [
        "draft",
        "ready_for_review",
        "confirmed",
        "executing",
        "reviewed",
        "accepted",
        "superseded"
      ]
    },
    "content_hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "material_snapshot_id": {
      "$ref": "#/$defs/identifier"
    },
    "analysis_snapshot_id": {
      "$ref": "#/$defs/identifier"
    },
    "system_skill_release": {
      "$ref": "#/$defs/identifier"
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160,
      "pattern": "^(?=.*\\S)[^\\u0000]+$"
    },
    "summary": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2000,
      "pattern": "^(?=.*\\S)[^\\u0000]+$"
    },
    "sections": {
      "type": "array",
      "minItems": 1,
      "maxItems": 256,
      "items": {
        "$ref": "#/$defs/section"
      }
    }
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
    },
    "rational": {
      "type": "object",
      "additionalProperties": false,
      "required": ["num", "den"],
      "properties": {
        "num": { "type": "integer", "minimum": 1, "maximum": 1000000000 },
        "den": { "type": "integer", "minimum": 1, "maximum": 1000000000 }
      }
    },
    "sourceRange": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "candidate_id",
        "version_id",
        "stream_index",
        "start_pts",
        "end_pts",
        "time_base"
      ],
      "properties": {
        "candidate_id": {
          "$ref": "#/$defs/identifier"
        },
        "version_id": {
          "type": "string",
          "pattern": "^av_[0-9a-f]{32}$"
        },
        "stream_index": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2147483647
        },
        "start_pts": {
          "type": "string",
          "maxLength": 20,
          "pattern": "^-?(?:0|[1-9][0-9]*)$"
        },
        "end_pts": {
          "type": "string",
          "maxLength": 20,
          "pattern": "^-?(?:0|[1-9][0-9]*)$"
        },
        "time_base": { "$ref": "#/$defs/rational" }
      }
    },
    "section": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "section_id",
        "title",
        "purpose",
        "source_ranges",
        "edit_notes",
        "unknowns"
      ],
      "properties": {
        "section_id": {
          "$ref": "#/$defs/identifier"
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "purpose": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "source_ranges": {
          "type": "array",
          "minItems": 1,
          "maxItems": 512,
          "items": {
            "$ref": "#/$defs/sourceRange"
          }
        },
        "edit_notes": {
          "type": "string",
          "maxLength": 4000
        },
        "unknowns": {
          "type": "array",
          "maxItems": 128,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          }
        }
      }
    }
  }
}
