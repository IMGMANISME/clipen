{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://clipen.local/schemas/v1/validation-report.schema.json",
  "title": "Clipen Timeline Validation Report",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "report_id",
    "timeline_id",
    "capability_profile_id",
    "capability_content_hash",
    "status",
    "issues"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "report_id": { "$ref": "#/$defs/identifier" },
    "timeline_id": { "$ref": "#/$defs/identifier" },
    "capability_profile_id": { "$ref": "#/$defs/identifier" },
    "capability_content_hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "status": { "enum": ["pass", "warning", "blocking"] },
    "issues": {
      "type": "array",
      "maxItems": 100000,
      "items": { "$ref": "#/$defs/issue" }
    }
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
    },
    "boundedText": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2000,
      "pattern": "^(?=.*\\S)[^\\u0000]+$"
    },
    "issue": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "rule_id",
        "severity",
        "location",
        "item_id",
        "message",
        "suggestion",
        "evidence_refs"
      ],
      "properties": {
        "rule_id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_.-]{0,127}$"
        },
        "severity": { "enum": ["warning", "blocking"] },
        "location": {
          "type": "string",
          "maxLength": 1000,
          "pattern": "^(?:|/[^\\u0000]*)$"
        },
        "item_id": {
          "oneOf": [
            { "$ref": "#/$defs/identifier" },
            { "type": "null" }
          ]
        },
        "message": { "$ref": "#/$defs/boundedText" },
        "suggestion": { "$ref": "#/$defs/boundedText" },
        "evidence_refs": {
          "type": "array",
          "maxItems": 128,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/identifier" }
        }
      }
    }
  }
}
