{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://clipen.local/schemas/v1/edit-timeline.schema.json",
  "title": "Clipen Edit Timeline",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "timeline_id",
    "project_id",
    "plan_id",
    "plan_revision",
    "plan_content_hash",
    "frame_rate",
    "canvas",
    "tracks",
    "markers"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "timeline_id": { "$ref": "#/$defs/identifier" },
    "project_id": { "$ref": "#/$defs/identifier" },
    "plan_id": { "$ref": "#/$defs/identifier" },
    "plan_revision": { "type": "integer", "minimum": 1 },
    "plan_content_hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "frame_rate": { "$ref": "#/$defs/rational" },
    "canvas": {
      "type": "object",
      "additionalProperties": false,
      "required": ["width", "height"],
      "properties": {
        "width": { "type": "integer", "minimum": 1, "maximum": 65535 },
        "height": { "type": "integer", "minimum": 1, "maximum": 65535 }
      }
    },
    "tracks": {
      "type": "array",
      "minItems": 1,
      "maxItems": 256,
      "items": { "$ref": "#/$defs/track" }
    },
    "markers": {
      "type": "array",
      "maxItems": 100000,
      "items": { "$ref": "#/$defs/marker" }
    }
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
    },
    "rational": {
      "type": "object",
      "additionalProperties": false,
      "required": ["num", "den"],
      "properties": {
        "num": { "type": "integer", "minimum": 1, "maximum": 1000000000 },
        "den": { "type": "integer", "minimum": 1, "maximum": 1000000000 }
      }
    },
    "sourceRange": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version_id",
        "stream_index",
        "start_pts",
        "end_pts",
        "time_base",
        "handle_before_pts",
        "handle_after_pts"
      ],
      "properties": {
        "version_id": {
          "type": "string",
          "pattern": "^av_[0-9a-f]{32}$"
        },
        "stream_index": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2147483647
        },
        "start_pts": {
          "type": "string",
          "maxLength": 20,
          "pattern": "^-?(?:0|[1-9][0-9]*)$"
        },
        "end_pts": {
          "type": "string",
          "maxLength": 20,
          "pattern": "^-?(?:0|[1-9][0-9]*)$"
        },
        "time_base": { "$ref": "#/$defs/rational" },
        "handle_before_pts": {
          "type": "string",
          "maxLength": 19,
          "pattern": "^(?:0|[1-9][0-9]*)$"
        },
        "handle_after_pts": {
          "type": "string",
          "maxLength": 19,
          "pattern": "^(?:0|[1-9][0-9]*)$"
        }
      }
    },
    "effect": {
      "type": "object",
      "additionalProperties": false,
      "required": ["effect_id", "parameters"],
      "properties": {
        "effect_id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_.-]{0,127}$"
        },
        "parameters": {
          "type": "object",
          "maxProperties": 128
        }
      }
    },
    "mediaItem": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "item_id",
        "start_frame",
        "duration_frames",
        "source",
        "effects"
      ],
      "properties": {
        "kind": { "const": "media" },
        "item_id": { "$ref": "#/$defs/identifier" },
        "start_frame": { "type": "integer", "minimum": 0, "maximum": 9223372036854775807 },
        "duration_frames": { "type": "integer", "minimum": 1, "maximum": 9223372036854775807 },
        "source": { "$ref": "#/$defs/sourceRange" },
        "effects": {
          "type": "array",
          "maxItems": 128,
          "items": { "$ref": "#/$defs/effect" }
        }
      }
    },
    "textItem": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "item_id", "start_frame", "duration_frames", "text", "style_id"],
      "properties": {
        "kind": { "const": "text" },
        "item_id": { "$ref": "#/$defs/identifier" },
        "start_frame": { "type": "integer", "minimum": 0, "maximum": 9223372036854775807 },
        "duration_frames": { "type": "integer", "minimum": 1, "maximum": 9223372036854775807 },
        "text": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4000,
          "pattern": "^(?=.*\\S)[^\\u0000]+$"
        },
        "style_id": { "$ref": "#/$defs/identifier" }
      }
    },
    "graphicItem": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "item_id", "start_frame", "duration_frames", "artifact_id"],
      "properties": {
        "kind": { "const": "graphic" },
        "item_id": { "$ref": "#/$defs/identifier" },
        "start_frame": { "type": "integer", "minimum": 0, "maximum": 9223372036854775807 },
        "duration_frames": { "type": "integer", "minimum": 1, "maximum": 9223372036854775807 },
        "artifact_id": { "$ref": "#/$defs/identifier" }
      }
    },
    "track": {
      "oneOf": [
        { "$ref": "#/$defs/mediaTrack" },
        { "$ref": "#/$defs/titleTrack" },
        { "$ref": "#/$defs/graphicTrack" }
      ]
    },
    "mediaTrack": {
      "type": "object",
      "additionalProperties": false,
      "required": ["track_id", "kind", "items"],
      "properties": {
        "track_id": { "$ref": "#/$defs/identifier" },
        "kind": { "enum": ["video", "audio"] },
        "items": {
          "type": "array",
          "maxItems": 100000,
          "items": { "$ref": "#/$defs/mediaItem" }
        }
      }
    },
    "titleTrack": {
      "type": "object",
      "additionalProperties": false,
      "required": ["track_id", "kind", "items"],
      "properties": {
        "track_id": { "$ref": "#/$defs/identifier" },
        "kind": { "const": "title" },
        "items": {
          "type": "array",
          "maxItems": 100000,
          "items": { "$ref": "#/$defs/textItem" }
        }
      }
    },
    "graphicTrack": {
      "type": "object",
      "additionalProperties": false,
      "required": ["track_id", "kind", "items"],
      "properties": {
        "track_id": { "$ref": "#/$defs/identifier" },
        "kind": { "const": "graphic" },
        "items": {
          "type": "array",
          "maxItems": 100000,
          "items": { "$ref": "#/$defs/graphicItem" }
        }
      }
    },
    "marker": {
      "type": "object",
      "additionalProperties": false,
      "required": ["marker_id", "frame", "label", "note"],
      "properties": {
        "marker_id": { "$ref": "#/$defs/identifier" },
        "frame": { "type": "integer", "minimum": 0, "maximum": 9223372036854775807 },
        "label": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160,
          "pattern": "^(?=.*\\S)[^\\u0000]+$"
        },
        "note": {
          "type": "string",
          "maxLength": 2000,
          "pattern": "^[^\\u0000]*$"
        }
      }
    }
  }
}
