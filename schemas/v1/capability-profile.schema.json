{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://clipen.local/schemas/v1/capability-profile.schema.json",
  "title": "Clipen Capability Profile",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "profile_id",
    "revision",
    "elements",
    "effects",
    "content_hash"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "profile_id": { "$ref": "#/$defs/identifier" },
    "revision": { "type": "integer", "minimum": 1 },
    "elements": {
      "type": "array",
      "maxItems": 4,
      "items": { "$ref": "#/$defs/elementCapability" }
    },
    "effects": {
      "type": "array",
      "maxItems": 10000,
      "items": { "$ref": "#/$defs/effectCapability" }
    },
    "content_hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
    },
    "delivery": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "implementation_id", "test_report_id"],
      "properties": {
        "mode": { "enum": ["movie", "resolve_project"] },
        "implementation_id": { "$ref": "#/$defs/identifier" },
        "test_report_id": { "$ref": "#/$defs/identifier" }
      }
    },
    "deliveries": {
      "type": "array",
      "maxItems": 2,
      "items": { "$ref": "#/$defs/delivery" }
    },
    "elementCapability": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "deliveries"],
      "properties": {
        "kind": { "enum": ["video", "audio", "title", "graphic"] },
        "deliveries": { "$ref": "#/$defs/deliveries" }
      }
    },
    "effectCapability": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "effect_id",
        "version",
        "track_kinds",
        "parameter_schema",
        "deliveries"
      ],
      "properties": {
        "effect_id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_.-]{0,127}$"
        },
        "version": { "type": "integer", "minimum": 1 },
        "track_kinds": {
          "type": "array",
          "minItems": 1,
          "maxItems": 4,
          "uniqueItems": true,
          "items": { "enum": ["video", "audio", "title", "graphic"] }
        },
        "parameter_schema": { "type": "object" },
        "deliveries": { "$ref": "#/$defs/deliveries" }
      }
    }
  }
}
