{
  "name": "@clipen/clipen-cli",
  "version": "1.0.6",
  "description": "讓 AI 用 Claude Code 或 Codex 幫你剪影片，再用時間線上的審片注記修改",
  "keywords": [
    "video-editing",
    "ai",
    "claude-code",
    "codex",
    "vlog",
    "local-first",
    "cli"
  ],
  "homepage": "https://github.com/IMGMANISME/clipen#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/IMGMANISME/clipen.git"
  },
  "bugs": {
    "url": "https://github.com/IMGMANISME/clipen/issues"
  },
  "license": "MIT",
  "bin": {
    "clipen": "bin/clipen.js"
  },
  "files": [
    "bin/clipen.js",
    "src/clipen/",
    "!src/clipen/**/__pycache__/",
    "!src/clipen/rendering/fonts/*.ttf",
    "apps/web/dist/",
    "requirements/",
    "pyproject.toml",
    "clipen",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18"
  },
  "os": [
    "darwin"
  ],
  "cpu": [
    "arm64"
  ],
  "scripts": {
    "prepack": "npm --prefix apps/web run build 1>&2",
    "test": "node --test tests/npm/",
    "release": "node scripts/release.mjs"
  },
  "publishConfig": {
    "access": "public"
  }
}
